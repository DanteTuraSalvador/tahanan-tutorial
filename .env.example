# Tahanan Tutorial Center — environment variables
#
# Copy this file to `.env` for local development. `.env` is gitignored.

# Groq API key for the AI chat assistant.
# - Local dev: this key is read by Vite (vite.config.js) to inject into the
#   /api/chat proxy. NEVER prefixed with VITE_ — that would expose it in the bundle.
# - Production (Cloudflare Pages): set this same variable name in the
#   Cloudflare dashboard under Settings → Environment variables (as a secret).
#
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
